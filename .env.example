# Copy this file to .env and fill in the values. Never commit .env.

# Token from @BotFather (the bot must be an administrator of the channel).
BOT_TOKEN=123456789:replace-with-token-from-BotFather

# Public channel name with @ (or a numeric chat id for a private channel).
CHANNEL=@your_channel

# Optional. Empty = SQLite file data/tracker.db.
# Other options: sqlite:///absolute/path/to.db  or  postgresql://user:password@host/dbname
DATABASE_URL=

# Optional. Model that calls the image tool in skills/codex-image (see codex_image.py for the default).
# CODEX_IMAGE_HOST_MODEL=
